;; The SDL environment of Atmos: the window, the input, the images, the
;; text, the sound, the time, and a test mode with no screen. The
;; reference is `doc/api.md`.
;;
;;      include "sdl.atm"
;;      ATMOS_LDFLAGS="-lSDL2 -lSDL2_image -lSDL2_ttf -lSDL2_mixer" atmos game.atm
;;
;; or, with no `include`, with `atmos-sdl`, the compiler dedicated to this
;; environment (`make`).
;;
;; The program runs inside the loop of SDL, which emits:
;;
;;      :quit                       the window was closed (the program
;;                                  terminates)
;;      :key.dn [key=,code=]        a key was pressed: the name of the key
;;                                  ('A', 'Return', ...), and the name of
;;                                  its scancode, the key at that place
;;                                  of a US keyboard
;;      :key.up [key=,code=]        a key was released
;;      :mouse.motion [x=,y=]       the mouse moved
;;      :mouse.button.dn [x=,y=,button=]    a button was pressed
;;      :mouse.button.up [x=,y=,button=]    (1 left, 2 middle, 3 right)
;;      :frame [n=,us=]             once per frame, for the logic: the
;;                                  number of the frame, from 1, and
;;                                  the time since the last one, in
;;                                  microseconds
;;      :draw                       once per frame, to redraw the screen
;;
;; A frame is, in this order: the input, `:frame`, the time, the passes
;; of drawing (`:draw`), the function of flush, the screenshot.
;; The time passes once per frame, so that `await 1s` and
;; `loop us on :clock` work as usual.
;;
;; Images, fonts, and sounds are native values: `pin` them to release
;; them with their block, or let them go with their last reference.
;;
;; To test with no screen, set `SDL_VIDEODRIVER=dummy` and:
;;
;;      SDL_ATM_FRAMES=n[:ms]   runs `n` frames of `ms` milliseconds (or of
;;                              1/fps s, see `sdl.window`), then quits
;;      SDL_ATM_KEYS=f:dn:A,... presses (`dn`) or releases (`up`) keys at frames
;;                              (by the name of the key)
;;      SDL_ATM_MOUSE=f:mv:x:y,f:dn:x:y:b,f:up:x:y:b
;;                              moves the mouse, presses or releases the
;;                              button `b` at a position (moving there
;;                              first, if it is elsewhere), at frames
;;      SDL_ATM_SHOT=f:x.png,...  saves the screen at frames
;;      SDL_ATM_MUTE=1          opens no audio device
;;      SDL_ATM_RENDER=1        a frame with no screenshot is rendered too
;;                              (see `sdl_on_flush`)
;;
;; The frames count from 1. A value `@file` gives the entries in a file,
;; separated by commas or new lines.

```:prelude
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <SDL2/SDL.h>
#include <SDL2/SDL_image.h>
#include <SDL2/SDL_ttf.h>
#include <SDL2/SDL_mixer.h>

// The tags of the events, all in this place.
#define SDL_EVT_QUIT    "quit"
#define SDL_EVT_KEY_DN  "key.dn"
#define SDL_EVT_KEY_UP  "key.up"
#define SDL_EVT_MOTION  "mouse.motion"
#define SDL_EVT_BUT_DN  "mouse.button.dn"
#define SDL_EVT_BUT_UP  "mouse.button.up"
#define SDL_EVT_FRAME   "frame"
#define SDL_EVT_DRAW    "draw"

// The fields of the events.
#define SDL_FLD_KEY     "key"
#define SDL_FLD_CODE    "code"
#define SDL_FLD_X       "x"
#define SDL_FLD_Y       "y"
#define SDL_FLD_BUTTON  "button"
#define SDL_FLD_N       "n"
#define SDL_FLD_US      "us"

static SDL_Window*   SDL_WIN = NULL;
static SDL_Renderer* SDL_REN = NULL;
static SDL_Surface*  SDL_SCR = NULL;    // the screen, in the software path
static SDL_Texture*  SDL_SCR_TEX = NULL;
static int           SDL_LW  = 0;       // the logical size, or 0
static int           SDL_LH  = 0;
static int           SDL_FPS = 60;      // the cap of frames per second (0: none)
static int           SDL_FIXED = 0;     // frames of exactly 1/SDL_FPS s
static int           SDL_SND = 0;       // the audio device is open
static double        SDL_SND_VOL = 1.0; // the volume of the sounds
static Mix_Music*    SDL_MUS = NULL;    // the music, and its file
static double        SDL_MUS_FROM = 0;  // its loop: from `to` back to `from`
static double        SDL_MUS_TO   = 0;  //  (seconds; no loop if `to` is 0)
static char*         SDL_MUS_PATH = NULL;
static int           SDL_MX  = 0;       // the last position of the mouse
static int           SDL_MY  = 0;
static Uint8         SDL_KEYS[SDL_NUM_SCANCODES];  // pressed, by scancode
static double        SDL_CLOCK = 1.0;   // the factor of the clock
static int           SDL_FRAME = 0;     // the current frame, from 1
static int           SDL_TESTING = 0;   // in the test mode (SDL_ATM_FRAMES)
static void        (*SDL_FLUSH) (int) = NULL;  // see sdl_on_flush
static char*         SDL_PASSES[8] = { NULL };  // the tags of the passes

static const char* SDL_KIND_IMG = "sdl.image";
static const char* SDL_KIND_FNT = "sdl.font";
static const char* SDL_KIND_SND = "sdl.sound";

// An image: its pixels in a surface, and a texture made from it at its
// first draw. The surface has the format of the file; in the software
// path, it is converted to ARGB8888 at its first draw, unless `raw`.
typedef struct {
    SDL_Surface* sfc;
    SDL_Texture* tex;
    int          raw;   // keeps the format of the file
    int          cvt;   // converted to ARGB8888 (software path)
} SDL_Image;

static void sdl_img_fin (void* p) {
    SDL_Image* img = p;
    if (img->tex != NULL) {
        SDL_DestroyTexture(img->tex);
    }
    SDL_FreeSurface(img->sfc);
    free(img);
}

static void sdl_fnt_fin (void* p) { TTF_CloseFont(p); }

// A sound: its chunk, or NULL with no audio device.
typedef struct {
    Mix_Chunk* chk;
} SDL_Sound;

static void sdl_snd_fin (void* p) {
    SDL_Sound* snd = p;
    if (snd->chk != NULL) {
        Mix_FreeChunk(snd->chk);
    }
    free(snd);
}

// A number as an int (truncated), or `def`.
static int sdl_int (AVal v, int def) {
    return a_isnum(v) ? (int)a_dbl(v) : def;
}

// 0xRRGGBBAA as a color, or `def`.
static SDL_Color sdl_rgba (AVal v, uint32_t def) {
    uint32_t c = a_isnum(v) ? (uint32_t)(int64_t)a_dbl(v) : def;
    SDL_Color clr = { (c>>24)&0xFF, (c>>16)&0xFF, (c>>8)&0xFF, c&0xFF };
    return clr;
}

// Field of a table as a number, or `def`.
static double sdl_fld (AVal t, const char* k, double def) {
    if (t.type != A_TAB) {
        return def;
    }
    AVal key = a_strz(k);
    AVal v = a_tab_get(A_TAB_OF(t), key);
    a_dec(key);
    return a_isnum(v) ? a_dbl(v) : def;
}

// Field of a table as a C string, or `def`.
static const char* sdl_str (AVal t, const char* k, const char* def) {
    if (t.type != A_TAB) {
        return def;
    }
    AVal key = a_strz(k);
    AVal v = a_tab_get(A_TAB_OF(t), key);
    a_dec(key);
    return (v.type == A_STR) ? A_STR_OF(v)->s : def;
}

// Whether the key of a name is pressed: the name of a key ('A',
// 'Left Shift'), or else of a scancode.
static int sdl_key (AVal name) {
    if (name.type != A_STR) {
        return 0;
    }
    SDL_Keycode key = SDL_GetKeyFromName(A_STR_OF(name)->s);
    SDL_Scancode code = (key != SDLK_UNKNOWN) ? SDL_GetScancodeFromKey(key)
        : SDL_GetScancodeFromName(A_STR_OF(name)->s);
    return (code>SDL_SCANCODE_UNKNOWN && code<SDL_NUM_SCANCODES) ? SDL_KEYS[code] : 0;
}

// The window in fullscreen or not, its size (if not in fullscreen, and
// greater than 0), the mouse grabbed in it, and the cursor shown. In
// the test mode, the window keeps its size.
static void sdl_display (int full, int w, int h, int grab, int cursor) {
    if (SDL_WIN == NULL) {
        return;
    }
    if (!SDL_TESTING) {
        SDL_SetWindowFullscreen(SDL_WIN, full ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
        if (!full && w>0 && h>0) {
            SDL_SetWindowSize(SDL_WIN, w, h);
            SDL_SetWindowPosition(SDL_WIN, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
        }
    }
    SDL_SetWindowGrab(SDL_WIN, grab ? SDL_TRUE : SDL_FALSE);
    SDL_ShowCursor(cursor ? SDL_ENABLE : SDL_DISABLE);
}

// Field `k` of a table, borrowed, or nil.
static AVal sdl_get (AVal t, AVal k) {
    return (t.type == A_TAB) ? a_tab_get(A_TAB_OF(t), k) : a_nil();
}

static void sdl_window (AVal t) {
    int w = (int) sdl_fld(t, "width",  640);
    int h = (int) sdl_fld(t, "height", 480);
    int fps = (int) sdl_fld(t, "fps", 60);
    SDL_FPS = (fps > 0) ? fps : 0;
    AVal k = a_strz("fixed");
    SDL_FIXED = a_truthy(sdl_get(t, k));
    a_dec(k);
    k = a_strz("logical");
    AVal lg = sdl_get(t, k);
    a_dec(k);
    SDL_LW = sdl_int(sdl_get(lg, a_int(0)), 0);
    SDL_LH = sdl_int(sdl_get(lg, a_int(1)), 0);
    SDL_WIN = SDL_CreateWindow(sdl_str(t,"title","Atmos"),
        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w, h, 0);
    if (SDL_WIN != NULL) {
        SDL_REN = SDL_CreateRenderer(SDL_WIN, -1, 0);
    }
    if (SDL_REN == NULL) {
        fprintf(stderr, "sdl : %s\n", SDL_GetError());
        exit(1);
    }
    // the passes of drawing: the tags of a vector, or "draw"
    k = a_strz("passes");
    AVal ps = sdl_get(t, k);
    a_dec(k);
    for (int i=0; i<7; i++) {
        AVal p = sdl_get(ps, a_int(i));
        if (p.type != A_STR) {
            break;
        }
        SDL_PASSES[i] = strdup(A_STR_OF(p)->s);
    }
    k = a_strz("software");
    int soft = a_truthy(sdl_get(t, k));
    a_dec(k);
    if (soft) {
        // the screen is a surface of the logical size, copied to a
        // texture at each frame, and stretched to the window
        int sw = (SDL_LW>0 && SDL_LH>0) ? SDL_LW : w;
        int sh = (SDL_LW>0 && SDL_LH>0) ? SDL_LH : h;
        SDL_SCR = SDL_CreateRGBSurfaceWithFormat(0, sw, sh, 32, SDL_PIXELFORMAT_ARGB8888);
        SDL_SCR_TEX = SDL_CreateTexture(SDL_REN, SDL_PIXELFORMAT_ARGB8888,
            SDL_TEXTUREACCESS_STREAMING, sw, sh);
    } else if (SDL_LW>0 && SDL_LH>0) {
        SDL_RenderSetLogicalSize(SDL_REN, SDL_LW, SDL_LH);
    }
}

// An image from a file, or nil. `raw`: see SDL_Image.
static AVal sdl_image (AVal path, int raw) {
    SDL_Surface* sfc = (path.type == A_STR) ? IMG_Load(A_STR_OF(path)->s) : NULL;
    if (sfc == NULL) {
        return a_nil();
    }
    SDL_Image* img = malloc(sizeof(SDL_Image));
    img->sfc = sfc;
    img->tex = NULL;
    img->raw = raw;
    img->cvt = 0;
    return a_nat(img, sdl_img_fin, SDL_KIND_IMG);
}

// The image of a value, or NULL.
static SDL_Image* sdl_img (AVal v) {
    return (a_nat_is(v,SDL_KIND_IMG)) ? a_nat_ptr(v) : NULL;
}

// The texture of an image, made at its first use, or NULL.
static SDL_Texture* sdl_img_tex (SDL_Image* img) {
    if (img==NULL || SDL_REN==NULL) {
        return NULL;
    }
    if (img->tex == NULL) {
        img->tex = SDL_CreateTextureFromSurface(SDL_REN, img->sfc);
    }
    return img->tex;
}

///////////////////////////////////////////////////////////////////////////////
// THE DOOR IN C
//
// For the C of a program, which draws by itself or keeps pointers of
// SDL. The program keeps the values alive: a pointer that it takes from
// an image is valid while the image is.
//
//  SDL_Window*   sdl_win  (void)       the window, or NULL
//  SDL_Renderer* sdl_ren  (void)       the renderer, or NULL
//  SDL_Surface*  sdl_scr  (void)       the screen, in the software path
//  void          sdl_size (int* w, int* h)
//                                      the size the program draws in
//  SDL_Surface*  sdl_sfc  (AVal img)   the pixels of an image, or NULL
//  SDL_Texture*  sdl_tex  (AVal img)   the texture of an image, or NULL
//  AVal          sdl_new_image (SDL_Surface* sfc)
//                                      an image that owns `sfc`
//  void          sdl_on_flush (void (*f) (int render))
//                                      `f` runs at each frame, after the
//                                      passes of drawing, and before the
//                                      screenshot and the present;
//                                      `render` is 0 in a frame of the
//                                      test mode with no screenshot
//  int           SDL_FRAME, SDL_TESTING    as sdl.frame(), sdl.testing()
///////////////////////////////////////////////////////////////////////////////

static SDL_Window*   sdl_win (void) { return SDL_WIN; }
static SDL_Renderer* sdl_ren (void) { return SDL_REN; }
static SDL_Surface*  sdl_scr (void) { return SDL_SCR; }

static void sdl_size (int* w, int* h) {
    *w = *h = 0;
    if (SDL_SCR != NULL) {
        *w = SDL_SCR->w;
        *h = SDL_SCR->h;
    } else if (SDL_LW>0 && SDL_LH>0) {
        *w = SDL_LW;
        *h = SDL_LH;
    } else if (SDL_REN != NULL) {
        SDL_GetRendererOutputSize(SDL_REN, w, h);
    }
}

static SDL_Surface* sdl_sfc (AVal v) {
    SDL_Image* img = sdl_img(v);
    return (img == NULL) ? NULL : img->sfc;
}

static SDL_Texture* sdl_tex (AVal v) {
    return sdl_img_tex(sdl_img(v));
}

static AVal sdl_new_image (SDL_Surface* sfc) {
    if (sfc == NULL) {
        return a_nil();
    }
    SDL_Image* img = malloc(sizeof(SDL_Image));
    img->sfc = sfc;
    img->tex = NULL;
    img->raw = 1;
    img->cvt = 0;
    return a_nat(img, sdl_img_fin, SDL_KIND_IMG);
}

static void sdl_on_flush (void (*f) (int render)) {
    SDL_FLUSH = f;
}

static AVal sdl_font (AVal path, AVal size) {
    TTF_Font* fnt = (path.type == A_STR && a_isnum(size))
        ? TTF_OpenFont(A_STR_OF(path)->s, (int)a_dbl(size)) : NULL;
    return (fnt == NULL) ? a_nil() : a_nat(fnt, sdl_fnt_fin, SDL_KIND_FNT);
}

static int sdl_img_dim (AVal v, int width) {
    SDL_Image* img = sdl_img(v);
    if (img == NULL) {
        return 0;
    }
    return width ? img->sfc->w : img->sfc->h;
}

// Draws the part `src` of an image into `dst`, with an alpha.
static void sdl_blit (AVal v, SDL_Rect* src, SDL_Rect* dst, int alpha) {
    if (SDL_SCR != NULL) {
        SDL_Image* img = sdl_img(v);
        if (img == NULL) {
            return;
        }
        if (!img->raw && !img->cvt) {
            SDL_Surface* cvt = SDL_ConvertSurfaceFormat(img->sfc, SDL_PIXELFORMAT_ARGB8888, 0);
            if (cvt == NULL) {
                return;
            }
            SDL_FreeSurface(img->sfc);
            img->sfc = cvt;
            img->cvt = 1;
        }
        if (dst == NULL) {
            return;     // only converts it
        }
        SDL_SetSurfaceBlendMode(img->sfc, SDL_BLENDMODE_BLEND);
        SDL_SetSurfaceAlphaMod(img->sfc, alpha);
        int w = src ? src->w : img->sfc->w;
        int h = src ? src->h : img->sfc->h;
        if (dst->w==w && dst->h==h) {
            SDL_BlitSurface(img->sfc, src, SDL_SCR, dst);
        } else {
            SDL_BlitScaled(img->sfc, src, SDL_SCR, dst);
        }
        SDL_SetSurfaceAlphaMod(img->sfc, 255);
        return;
    }
    SDL_Texture* tex = sdl_img_tex(sdl_img(v));
    if (tex == NULL) {
        return;
    }
    if (alpha != 255) {
        SDL_SetTextureAlphaMod(tex, alpha);
    }
    SDL_RenderCopy(SDL_REN, tex, src, dst);
    if (alpha != 255) {
        SDL_SetTextureAlphaMod(tex, 255);
    }
}

// Draws a whole image at a position.
static void sdl_draw (AVal v, int x, int y) {
    SDL_Image* img = sdl_img(v);
    if (img != NULL) {
        SDL_Rect d = { x, y, img->sfc->w, img->sfc->h };
        sdl_blit(v, NULL, &d, 255);
    }
}

// Draws the part `s` of an image into `d`, with an alpha.
static void sdl_part (AVal v, int sx, int sy, int sw, int sh,
    int x, int y, int w, int h, int alpha)
{
    SDL_Rect s = { sx, sy, sw, sh };
    SDL_Rect d = { x, y, w, h };
    sdl_blit(v, &s, &d, alpha);
}

// Draws the part `s` of an image into `d`, rotated by `angle` degrees
// (clockwise, around the center of `d`), flipped (1 horizontally, 2
// vertically, 3 both), modulated by the color `rgba` (its alpha too),
// with a blend mode (0 blend, 1 add, 2 mod, 3 none). In the software
// path, the rotation and the flips are ignored.
static void sdl_draw_ex (AVal v, int sx, int sy, int sw, int sh,
    int x, int y, int w, int h, double angle, int flip, AVal rgba, int blend)
{
    static const SDL_BlendMode MODES[] = {
        SDL_BLENDMODE_BLEND, SDL_BLENDMODE_ADD, SDL_BLENDMODE_MOD, SDL_BLENDMODE_NONE
    };
    SDL_BlendMode mode = MODES[(blend>=0 && blend<=3) ? blend : 0];
    SDL_Color c = sdl_rgba(rgba, 0xFFFFFFFF);
    SDL_Rect src = { sx, sy, sw, sh };
    SDL_Rect dst = { x, y, w, h };
    SDL_Image* img = sdl_img(v);
    if (img == NULL) {
        return;
    }
    if (SDL_SCR != NULL) {
        sdl_blit(v, NULL, NULL, -1);    // converts it, if it is not raw
        SDL_SetSurfaceBlendMode(img->sfc, mode);
        SDL_SetSurfaceColorMod(img->sfc, c.r, c.g, c.b);
        SDL_SetSurfaceAlphaMod(img->sfc, c.a);
        if (dst.w==sw && dst.h==sh) {
            SDL_BlitSurface(img->sfc, &src, SDL_SCR, &dst);
        } else {
            SDL_BlitScaled(img->sfc, &src, SDL_SCR, &dst);
        }
        SDL_SetSurfaceBlendMode(img->sfc, SDL_BLENDMODE_BLEND);
        SDL_SetSurfaceColorMod(img->sfc, 255, 255, 255);
        SDL_SetSurfaceAlphaMod(img->sfc, 255);
        return;
    }
    SDL_Texture* tex = sdl_img_tex(img);
    if (tex == NULL) {
        return;
    }
    SDL_BlendMode old;
    SDL_GetTextureBlendMode(tex, &old);
    SDL_SetTextureBlendMode(tex, mode);
    SDL_SetTextureColorMod(tex, c.r, c.g, c.b);
    SDL_SetTextureAlphaMod(tex, c.a);
    SDL_RenderCopyEx(SDL_REN, tex, &src, &dst, angle, NULL,
        (SDL_RendererFlip)(((flip&1) ? SDL_FLIP_HORIZONTAL : 0) | ((flip&2) ? SDL_FLIP_VERTICAL : 0)));
    SDL_SetTextureBlendMode(tex, old);
    SDL_SetTextureColorMod(tex, 255, 255, 255);
    SDL_SetTextureAlphaMod(tex, 255);
}

// Fills a rectangle of the screen surface, blending its color.
static void sdl_scr_fill (SDL_Color c, int x, int y, int w, int h) {
    SDL_Rect r = { x, y, w, h };
    if (c.a == 255) {
        SDL_FillRect(SDL_SCR, &r, SDL_MapRGBA(SDL_SCR->format, c.r, c.g, c.b, 255));
        return;
    }
    if (w<=0 || h<=0) {
        return;
    }
    SDL_Surface* sfc = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32, SDL_PIXELFORMAT_ARGB8888);
    SDL_FillRect(sfc, NULL, SDL_MapRGBA(sfc->format, c.r, c.g, c.b, c.a));
    SDL_SetSurfaceBlendMode(sfc, SDL_BLENDMODE_BLEND);
    SDL_BlitSurface(sfc, NULL, SDL_SCR, &r);
    SDL_FreeSurface(sfc);
}

// Fills (`fill`) or outlines a rectangle, with a color.
static void sdl_rect (AVal rgba, int x, int y, int w, int h, int fill) {
    SDL_Color c = sdl_rgba(rgba, 0xFFFFFFFF);
    if (SDL_SCR != NULL) {
        if (fill) {
            sdl_scr_fill(c, x, y, w, h);
        } else if (w>0 && h>0) {
            sdl_scr_fill(c, x, y, w, 1);
            if (h > 1) {
                sdl_scr_fill(c, x, y+h-1, w, 1);
            }
            if (h > 2) {
                sdl_scr_fill(c, x, y+1, 1, h-2);
                if (w > 1) {
                    sdl_scr_fill(c, x+w-1, y+1, 1, h-2);
                }
            }
        }
        return;
    }
    if (SDL_REN == NULL) {
        return;
    }
    SDL_Rect r = { x, y, w, h };
    SDL_SetRenderDrawBlendMode(SDL_REN, SDL_BLENDMODE_BLEND);
    SDL_SetRenderDrawColor(SDL_REN, c.r, c.g, c.b, c.a);
    if (fill) {
        SDL_RenderFillRect(SDL_REN, &r);
    } else {
        SDL_RenderDrawRect(SDL_REN, &r);
    }
}

static void sdl_line (AVal rgba, int x1, int y1, int x2, int y2) {
    SDL_Color c = sdl_rgba(rgba, 0xFFFFFFFF);
    if (SDL_SCR != NULL) {
        // Bresenham, a pixel at a time
        int dx = abs(x2-x1), sx = (x1<x2) ? 1 : -1;
        int dy = -abs(y2-y1), sy = (y1<y2) ? 1 : -1;
        int err = dx + dy;
        while (1) {
            sdl_scr_fill(c, x1, y1, 1, 1);
            if (x1==x2 && y1==y2) {
                break;
            }
            int e2 = 2 * err;
            if (e2 >= dy) {
                err += dy;
                x1 += sx;
            }
            if (e2 <= dx) {
                err += dx;
                y1 += sy;
            }
        }
        return;
    }
    if (SDL_REN == NULL) {
        return;
    }
    SDL_SetRenderDrawBlendMode(SDL_REN, SDL_BLENDMODE_BLEND);
    SDL_SetRenderDrawColor(SDL_REN, c.r, c.g, c.b, c.a);
    SDL_RenderDrawLine(SDL_REN, x1, y1, x2, y2);
}

// The size of a text in a font, or 0, 0.
static int sdl_text_dim (AVal fnt, AVal txt, int width) {
    int w=0, h=0;
    if (a_nat_is(fnt,SDL_KIND_FNT) && txt.type==A_STR) {
        TTF_SizeUTF8(a_nat_ptr(fnt), A_STR_OF(txt)->s, &w, &h);
    }
    return width ? w : h;
}

// Writes a text with a color, at `x` (aligned: 0 left, 1 center, 2
// right) and `y` (its top).
static void sdl_text (AVal fnt, AVal txt, int x, int y, AVal rgba, int align) {
    if (!a_nat_is(fnt,SDL_KIND_FNT) || txt.type!=A_STR || SDL_REN==NULL) {
        return;
    }
    SDL_Color c = sdl_rgba(rgba, 0xFFFFFFFF);
    SDL_Surface* sfc = TTF_RenderUTF8_Blended(a_nat_ptr(fnt), A_STR_OF(txt)->s, c);
    if (sfc == NULL) {
        return;
    }
    SDL_Rect r = { x - (align*sfc->w)/2, y, sfc->w, sfc->h };
    if (SDL_SCR != NULL) {
        SDL_BlitSurface(sfc, NULL, SDL_SCR, &r);
    } else {
        SDL_Texture* tex = SDL_CreateTextureFromSurface(SDL_REN, sfc);
        SDL_RenderCopy(SDL_REN, tex, NULL, &r);
        SDL_DestroyTexture(tex);
    }
    SDL_FreeSurface(sfc);
}

// A sound from a file, or nil. With no audio device (SDL_ATM_MUTE),
// a sound has no chunk, and plays nothing, if its file exists.
static AVal sdl_sound (AVal path) {
    if (path.type != A_STR) {
        return a_nil();
    }
    Mix_Chunk* chk = NULL;
    if (SDL_SND) {
        chk = Mix_LoadWAV(A_STR_OF(path)->s);
        if (chk == NULL) {
            return a_nil();
        }
    } else {
        SDL_RWops* f = SDL_RWFromFile(A_STR_OF(path)->s, "rb");
        if (f == NULL) {
            return a_nil();
        }
        SDL_RWclose(f);
    }
    SDL_Sound* snd = malloc(sizeof(SDL_Sound));
    snd->chk = chk;
    return a_nat(snd, sdl_snd_fin, SDL_KIND_SND);
}

// Plays a sound once, with a volume (0 to 1) times the volume of the
// sounds. Returns its channel, or -1.
static int sdl_play (AVal v, double vol) {
    SDL_Sound* snd = a_nat_is(v,SDL_KIND_SND) ? a_nat_ptr(v) : NULL;
    if (snd==NULL || snd->chk==NULL) {
        return -1;
    }
    int ch = Mix_PlayChannel(-1, snd->chk, 0);
    if (ch >= 0) {
        Mix_Volume(ch, (int)(vol * SDL_SND_VOL * MIX_MAX_VOLUME));
    }
    return ch;
}

// Stops the music, at once (`fade` is 0) or fading out in `fade` ms.
static void sdl_music_stop (int fade) {
    if (SDL_MUS == NULL) {
        return;
    }
    if (fade > 0) {
        Mix_FadeOutMusic(fade);     // freed by the next music, or at the end
    } else {
        Mix_HaltMusic();
        Mix_FreeMusic(SDL_MUS);
        SDL_MUS = NULL;
    }
    free(SDL_MUS_PATH);
    SDL_MUS_PATH = NULL;
}

// Plays a music, `loops` times (-1 forever), in place of the current
// one. The same music that already plays goes on. Returns whether the
// file was loaded (always true with no audio device).
static int sdl_music (AVal path, int loops, double from, double to) {
    if (path.type != A_STR) {
        return 0;
    }
    if (!SDL_SND) {
        return 1;
    }
    const char* p = A_STR_OF(path)->s;
    if (SDL_MUS_PATH!=NULL && !strcmp(SDL_MUS_PATH,p) && Mix_PlayingMusic()) {
        return 1;
    }
    SDL_MUS_FROM = from;
    SDL_MUS_TO   = to;
    if (SDL_MUS != NULL) {
        Mix_HaltMusic();
        Mix_FreeMusic(SDL_MUS);
        SDL_MUS = NULL;
    }
    free(SDL_MUS_PATH);
    SDL_MUS_PATH = NULL;
    SDL_MUS = Mix_LoadMUS(p);
    if (SDL_MUS == NULL) {
        return 0;
    }
    SDL_MUS_PATH = strdup(p);
    Mix_PlayMusic(SDL_MUS, (to > 0) ? -1 : loops);
    return 1;
}

// The loop of the music, once per frame: past `to`, back to `from`.
static void sdl_music_loop (void) {
    if (SDL_MUS!=NULL && SDL_MUS_TO>0 && SDL_MUS_PATH!=NULL) {
        double pos = Mix_GetMusicPosition(SDL_MUS);
        if (pos >= SDL_MUS_TO) {
            Mix_SetMusicPosition(SDL_MUS_FROM + (pos - SDL_MUS_TO));
        }
    }
}

// The position of the music, in seconds, or -1.
static double sdl_music_pos (void) {
    return (SDL_MUS!=NULL && SDL_MUS_PATH!=NULL) ? Mix_GetMusicPosition(SDL_MUS) : -1;
}

// The volumes of the sounds and of the music, from 0 to 1.
static void sdl_volume (double snd, double mus) {
    SDL_SND_VOL = snd;
    if (SDL_SND) {
        Mix_Volume(-1, (int)(snd * MIX_MAX_VOLUME));
        Mix_VolumeMusic((int)(mus * MIX_MAX_VOLUME));
    }
}

///////////////////////////////////////////////////////////////////////////////
// DRIVER
///////////////////////////////////////////////////////////////////////////////

// The fields of an event: up to two strings and three numbers. A field
// with a NULL name is not set.
typedef struct {
    const char* sk[2];
    const char* sv[2];
    const char* nk[3];
    int64_t     nv[3];
} SDL_Fields;

// Emits the tag alone (`f` is NULL), or a table with the tag and the
// fields.
static AStatus sdl_emit_f (const char* tag, const SDL_Fields* f) {
    AVal t = a_strz(tag);
    if (f == NULL) {
        AStatus st = atm_emit(t);
        a_dec(t);
        return st;
    }
    AVal evt = a_tab();
    a_tag(evt, t);
    for (int i=0; i<2; i++) {
        if (f->sk[i] != NULL) {
            AVal k = a_strz(f->sk[i]);
            AVal v = a_strz(f->sv[i]);
            a_setindex(evt, k, v);
            a_dec(k);
            a_dec(v);
        }
    }
    for (int i=0; i<3; i++) {
        if (f->nk[i] != NULL) {
            AVal k = a_strz(f->nk[i]);
            a_setindex(evt, k, a_int(f->nv[i]));
            a_dec(k);
        }
    }
    AStatus st = atm_emit(evt);
    a_dec(evt);
    a_dec(t);
    return st;
}

static AStatus sdl_emit (const char* tag) {
    return sdl_emit_f(tag, NULL);
}

// A key, by its keycode and its scancode.
static AStatus sdl_emit_key (const char* tag, SDL_Keycode key, SDL_Scancode code) {
    if (code>SDL_SCANCODE_UNKNOWN && code<SDL_NUM_SCANCODES) {
        SDL_KEYS[code] = !strcmp(tag, SDL_EVT_KEY_DN);
    }
    SDL_Fields f = {
        { SDL_FLD_KEY, SDL_FLD_CODE },
        { SDL_GetKeyName(key), SDL_GetScancodeName(code) },
        { NULL, NULL, NULL }, { 0, 0, 0 }
    };
    return sdl_emit_f(tag, &f);
}

// A key of a script, by its name: the scancode is that of the key.
static AStatus sdl_emit_key_name (const char* tag, const char* name) {
    SDL_Keycode key = SDL_GetKeyFromName(name);
    if (key == SDLK_UNKNOWN) {
        SDL_Fields f = {
            { SDL_FLD_KEY, NULL }, { name, NULL },
            { NULL, NULL, NULL }, { 0, 0, 0 }
        };
        return sdl_emit_f(tag, &f);
    }
    return sdl_emit_key(tag, key, SDL_GetScancodeFromKey(key));
}

// A motion (`but` is 0) or a button of the mouse, at a position.
static AStatus sdl_emit_mouse (const char* tag, int x, int y, int but) {
    SDL_MX = x;
    SDL_MY = y;
    SDL_Fields f = {
        { NULL, NULL }, { NULL, NULL },
        { SDL_FLD_X, SDL_FLD_Y, (but == 0) ? NULL : SDL_FLD_BUTTON },
        { x, y, but }
    };
    return sdl_emit_f(tag, &f);
}

// The frame: its number and its time.
static AStatus sdl_emit_frame (int n, int64_t us) {
    SDL_Fields f = {
        { NULL, NULL }, { NULL, NULL },
        { SDL_FLD_N, SDL_FLD_US, NULL }, { n, us, 0 }
    };
    return sdl_emit_f(SDL_EVT_FRAME, &f);
}

// The entries of a variable of the test mode, separated by commas or
// new lines: its value, or the contents of the file `x` if its value is
// `@x`. Read once. NULL if not set.
static const char* sdl_script_src (const char* var) {
    static struct { const char* var; char* src; } CACHE[8];
    static int N = 0;
    for (int i=0; i<N; i++) {
        if (!strcmp(CACHE[i].var, var)) {
            return CACHE[i].src;
        }
    }
    const char* v = getenv(var);
    char* src = NULL;
    if (v != NULL && v[0] == '@') {
        FILE* f = fopen(v+1, "rb");
        if (f == NULL) {
            fprintf(stderr, "sdl : %s : cannot open %s\n", var, v+1);
            exit(1);
        }
        fseek(f, 0, SEEK_END);
        long n = ftell(f);
        fseek(f, 0, SEEK_SET);
        src = malloc(n + 1);
        src[fread(src, 1, n, f)] = '\0';
        fclose(f);
    } else if (v != NULL) {
        src = strdup(v);
    }
    if (N < 8) {
        CACHE[N].var = var;
        CACHE[N].src = src;
        N++;
    }
    return src;
}

// Whether a variable of the test mode has an entry for a frame.
static int sdl_script_has (const char* var, int frame) {
    const char* s = sdl_script_src(var);
    while (s!=NULL && *s!='\0') {
        if (atoi(s) == frame) {
            return 1;
        }
        s += strcspn(s, ",\n");
        s += (*s==',' || *s=='\n');
    }
    return 0;
}

// Test script: the entries `frame:...` of a variable that are due.
static AStatus sdl_script (const char* var, int frame) {
    AStatus st = A_OK;
    const char* s = sdl_script_src(var);
    while (s!=NULL && *s!='\0' && st==A_OK) {
        char item[256];
        size_t n = strcspn(s, ",\n");
        snprintf(item, sizeof(item), "%.*s", (int)n, s);
        s += n + (s[n]==',' || s[n]=='\n');
        char* arg = strchr(item, ':');
        if (arg==NULL || atoi(item)!=frame) {
            continue;
        }
        arg++;
        if (!strcmp(var, "SDL_ATM_SHOT")) {
            // the screen surface (at the logical size), or what the
            // renderer drew (at the size of the window)
            SDL_Surface* sfc;
            if (SDL_SCR != NULL) {
                sfc = SDL_ConvertSurfaceFormat(SDL_SCR, SDL_PIXELFORMAT_RGBA32, 0);
            } else {
                int w, h;
                SDL_GetRendererOutputSize(SDL_REN, &w, &h);
                sfc = SDL_CreateRGBSurfaceWithFormat(0, w, h, 32,
                    SDL_PIXELFORMAT_RGBA32);
                SDL_RenderReadPixels(SDL_REN, NULL, SDL_PIXELFORMAT_RGBA32,
                    sfc->pixels, sfc->pitch);
            }
            IMG_SavePNG(sfc, arg);
            SDL_FreeSurface(sfc);
        } else if (!strcmp(var, "SDL_ATM_MOUSE")) {
            int x=0, y=0, but=1;
            if (sscanf(arg, "mv:%d:%d", &x, &y) == 2) {
                st = sdl_emit_mouse(SDL_EVT_MOTION, x, y, 0);
            } else if (sscanf(arg, "dn:%d:%d:%d", &x, &y, &but) >= 2
                    || sscanf(arg, "up:%d:%d:%d", &x, &y, &but) >= 2) {
                // as a real mouse, it moves to where the button changes
                if (x!=SDL_MX || y!=SDL_MY) {
                    st = sdl_emit_mouse(SDL_EVT_MOTION, x, y, 0);
                }
                if (st == A_OK) {
                    st = sdl_emit_mouse((arg[0]=='d') ? SDL_EVT_BUT_DN : SDL_EVT_BUT_UP, x, y, but);
                }
            }
        } else if (!strncmp(arg, "dn:", 3)) {
            st = sdl_emit_key_name(SDL_EVT_KEY_DN, arg+3);
        } else if (!strncmp(arg, "up:", 3)) {
            st = sdl_emit_key_name(SDL_EVT_KEY_UP, arg+3);
        }
    }
    return st;
}

int main (int argc, char** argv) {
    int mute = (getenv("SDL_ATM_MUTE") != NULL);
    if (mute || SDL_Init(SDL_INIT_VIDEO|SDL_INIT_AUDIO)!=0) {
        SDL_Init(SDL_INIT_VIDEO);
    }
    TTF_Init();
    SDL_SND = !mute && (Mix_OpenAudio(44100, MIX_DEFAULT_FORMAT, 2, 1024) == 0);
    if (SDL_SND) {
        Mix_AllocateChannels(64);
    }

    // test mode: a fixed number of frames with a fixed duration
    int frames = -1;
    SDL_TESTING = (getenv("SDL_ATM_FRAMES") != NULL);
    int fixed  = 0;
    if (getenv("SDL_ATM_FRAMES") != NULL) {
        sscanf(getenv("SDL_ATM_FRAMES"), "%d:%d", &frames, &fixed);
    }

    atm_init(argc, argv);
    AStatus st = atm_main();

    Uint64 freq = SDL_GetPerformanceFrequency();
    Uint64 prv  = SDL_GetPerformanceCounter();
    int quit = 0;
    for (int frame=1; st==A_OK && !quit && atm_alive(); frame++) {
        SDL_FRAME = frame;
        SDL_Event e;
        while (st==A_OK && SDL_PollEvent(&e)) {
            if (e.type == SDL_QUIT) {
                st = sdl_emit(SDL_EVT_QUIT);
                quit = 1;
            } else if (e.type==SDL_KEYDOWN && !e.key.repeat) {
                st = sdl_emit_key(SDL_EVT_KEY_DN, e.key.keysym.sym, e.key.keysym.scancode);
            } else if (e.type == SDL_KEYUP) {
                st = sdl_emit_key(SDL_EVT_KEY_UP, e.key.keysym.sym, e.key.keysym.scancode);
            } else if (e.type == SDL_MOUSEMOTION) {
                st = sdl_emit_mouse(SDL_EVT_MOTION, e.motion.x, e.motion.y, 0);
            } else if (e.type == SDL_MOUSEBUTTONDOWN) {
                st = sdl_emit_mouse(SDL_EVT_BUT_DN, e.button.x, e.button.y, e.button.button);
            } else if (e.type == SDL_MOUSEBUTTONUP) {
                st = sdl_emit_mouse(SDL_EVT_BUT_UP, e.button.x, e.button.y, e.button.button);
            }
        }
        if (st == A_OK) {
            st = sdl_script("SDL_ATM_KEYS", frame);
        }
        if (st == A_OK) {
            st = sdl_script("SDL_ATM_MOUSE", frame);
        }

        // time
        // The test mode, or a program with fixed frames, has frames of
        // exactly 1/SDL_FPS s: the n-th frame ends at n*1000000/SDL_FPS
        // us, so that SDL_FPS frames are exactly 1 s.
        Uint64 now = SDL_GetPerformanceCounter();
        int64_t us;
        if (fixed) {
            us = (int64_t)fixed * 1000;
        } else if (frames>0 || SDL_FIXED) {
            int fps = (SDL_FPS > 0) ? SDL_FPS : 60;
            us = ((int64_t)frame*1000000)/fps - ((int64_t)(frame-1)*1000000)/fps;
        } else {
            us = (int64_t)((now-prv)*1000000/freq);
        }
        prv = now;
        // logic
        if (st == A_OK) {
            st = sdl_emit_frame(frame, us);
        }

        if (st==A_OK && us>0) {
            // the clock of Atmos goes `SDL_CLOCK` times as fast, in the
            // unit of time of the build (A_TIME_US microseconds), and
            // carries what is less than a unit to the next frame
            static double acc = 0;
            acc += us * SDL_CLOCK;
            int64_t n = (int64_t)(acc / A_TIME_US);
            acc -= (double)n * A_TIME_US;
            if (n > 0) {
                st = atm_emit(a_int((AInt)n));
            }
        }

        // screen
        if (st==A_OK && SDL_REN!=NULL) {
            SDL_SetRenderDrawColor(SDL_REN, 0, 0, 0, 255);
            SDL_RenderClear(SDL_REN);
            if (SDL_SCR != NULL) {
                SDL_FillRect(SDL_SCR, NULL, SDL_MapRGBA(SDL_SCR->format, 0, 0, 0, 255));
            }
            if (SDL_PASSES[0] == NULL) {
                st = sdl_emit(SDL_EVT_DRAW);
            }
            for (int i=0; st==A_OK && SDL_PASSES[i]!=NULL; i++) {
                st = sdl_emit(SDL_PASSES[i]);
            }
            int shot = sdl_script_has("SDL_ATM_SHOT", frame);
            if (st==A_OK && SDL_FLUSH!=NULL) {
                SDL_FLUSH(!SDL_TESTING || shot || getenv("SDL_ATM_RENDER")!=NULL);
            }
            if (shot) {
                sdl_script("SDL_ATM_SHOT", frame);
            }
            if (SDL_SCR != NULL) {
                SDL_UpdateTexture(SDL_SCR_TEX, NULL, SDL_SCR->pixels, SDL_SCR->pitch);
                SDL_RenderCopy(SDL_REN, SDL_SCR_TEX, NULL, NULL);
            }
            SDL_RenderPresent(SDL_REN);
        }

        sdl_music_loop();

        // the cap: the rest of the frame, but not in the test mode
        if (frames>0 && frame>=frames) {
            quit = 1;
        } else if (frames<=0 && SDL_FPS>0) {
            Uint64 per   = freq / SDL_FPS;
            Uint64 spent = SDL_GetPerformanceCounter() - now;
            if (spent < per) {
                SDL_Delay((Uint32)((per-spent)*1000/freq));
            }
        }
    }

    if (st == A_OK) {
        st = atm_stop();
    }
    fflush(stdout);
    if (st == A_ESCAPE) {
        st = a_escape_err();
    }
    if (st != A_OK) {
        a_error_dump();
    }
    atm_quit();
    if (SDL_MUS != NULL) {
        Mix_HaltMusic();
        Mix_FreeMusic(SDL_MUS);
    }
    if (SDL_SCR != NULL) {
        SDL_FreeSurface(SDL_SCR);
        SDL_DestroyTexture(SDL_SCR_TEX);
    }
    for (int i=0; SDL_PASSES[i]!=NULL; i++) {
        free(SDL_PASSES[i]);
    }
    free(SDL_MUS_PATH);
    if (SDL_SND) {
        Mix_CloseAudio();
    }
    TTF_Quit();
    SDL_Quit();
    return (st == A_OK) ? 0 : 1;
}
```

pin sdl = [
    ;; sdl.window [title=, width=, height=, logical=[w,h], fps=, fixed=,
    ;;             software=, passes=]
    ;;  - logical: the size that the program draws in, scaled to the
    ;;    window (default: the size of the window)
    ;;  - fps: the cap of frames per second (default 60; 0, no cap)
    ;;  - fixed: if true, the time of a frame is exactly 1/fps s, and
    ;;    not the time measured (fps frames are exactly 1 s); the test
    ;;    mode is always so
    ;;  - software: if true, the screen is a surface of the logical size:
    ;;    an image is drawn with SDL_BlitSurface, a fill with
    ;;    SDL_FillRect, and the surface is copied to the window at each
    ;;    frame; a screenshot is the surface
    ;;  - passes: the tags of the passes of drawing, emitted in order at
    ;;    each frame (default [:draw]; at most 7)
    window = func (t) {
        `sdl_window($t);`
    },

    ;; sdl.image(path [,raw]): an image, or nil; in the software path,
    ;; its pixels are converted to ARGB8888 at its first draw, unless
    ;; `raw` keeps the format of the file (a blit with alpha gives other
    ;; pixels in each format)
    image = func (path, raw) {
        `:value sdl_image($path, a_truthy($raw))`
    },

    ;; sdl.size(img): the width and the height of an image
    size = func (img) {
        return `:number sdl_img_dim($img, 1)`, `:number sdl_img_dim($img, 0)`
    },

    ;; sdl.draw(img, x, y): the whole image at a position
    draw = func (img, x, y) {
        `sdl_draw($img, sdl_int($x,0), sdl_int($y,0));`
    },

    ;; sdl.part(img, sx,sy,sw,sh, x,y [,alpha]): a part of an image at a
    ;; position, with an alpha (0 to 255)
    part = func (img, sx,sy,sw,sh, x,y, alpha) {
        `sdl_part($img, sdl_int($sx,0), sdl_int($sy,0), sdl_int($sw,0), sdl_int($sh,0), sdl_int($x,0), sdl_int($y,0), sdl_int($sw,0), sdl_int($sh,0), sdl_int($alpha,255));`
    },

    ;; sdl.scale(img, sx,sy,sw,sh, x,y,w,h [,alpha]): a part of an image
    ;; into a rectangle of another size
    scale = func (img, sx,sy,sw,sh, x,y,w,h, alpha) {
        `sdl_part($img, sdl_int($sx,0), sdl_int($sy,0), sdl_int($sw,0), sdl_int($sh,0), sdl_int($x,0), sdl_int($y,0), sdl_int($w,0), sdl_int($h,0), sdl_int($alpha,255));`
    },

    ;; sdl.draw_ex(img, sx,sy,sw,sh, x,y,w,h [,angle [,flip [,rgba [,blend]]]]):
    ;; a part of an image into a rectangle, rotated by `angle` degrees
    ;; (clockwise, around its center), flipped (:h, :v, or :hv), with
    ;; its color and its alpha modulated by `rgba` (0xRRGGBBAA, default
    ;; 0xFFFFFFFF), and a blend mode (:blend default, :add, :mod,
    ;; :none); in the software path, no rotation and no flips
    draw_ex = func (img, sx,sy,sw,sh, x,y,w,h, angle, flip, rgba, blend) {
        val f = match flip {
            :h  => 1
            :v  => 2
            :hv => 3
            else => 0
        }
        val b = match blend {
            :add  => 1
            :mod  => 2
            :none => 3
            else  => 0
        }
        `sdl_draw_ex($img, sdl_int($sx,0), sdl_int($sy,0), sdl_int($sw,0), sdl_int($sh,0), sdl_int($x,0), sdl_int($y,0), sdl_int($w,0), sdl_int($h,0), a_isnum($angle) ? a_dbl($angle) : 0.0, sdl_int($f,0), $rgba, sdl_int($b,0));`
    },

    ;; sdl.fill(rgba, x,y,w,h): a filled rectangle, with a color
    ;; 0xRRGGBBAA
    fill = func (rgba, x,y,w,h) {
        `sdl_rect($rgba, sdl_int($x,0), sdl_int($y,0), sdl_int($w,0), sdl_int($h,0), 1);`
    },

    ;; sdl.rect(rgba, x,y,w,h): the outline of a rectangle
    rect = func (rgba, x,y,w,h) {
        `sdl_rect($rgba, sdl_int($x,0), sdl_int($y,0), sdl_int($w,0), sdl_int($h,0), 0);`
    },

    ;; sdl.line(rgba, x1,y1,x2,y2): a line
    line = func (rgba, x1,y1,x2,y2) {
        `sdl_line($rgba, sdl_int($x1,0), sdl_int($y1,0), sdl_int($x2,0), sdl_int($y2,0));`
    },

    ;; sdl.font(path, size): a font, or nil
    font = func (path, size) {
        `:value sdl_font($path, $size)`
    },

    ;; sdl.text(fnt, s, x, y, rgba [,align]): a text with a color, with
    ;; its top at `y`, and aligned at `x` by `align`: :left (default),
    ;; :center, or :right
    text = func (fnt, s, x, y, rgba, align) {
        val a = match align {
            :center => 1
            :right  => 2
            else    => 0
        }
        `sdl_text($fnt, $s, sdl_int($x,0), sdl_int($y,0), $rgba, sdl_int($a,0));`
    },

    ;; sdl.text_size(fnt, s): the width and the height of a text
    text_size = func (fnt, s) {
        return `:number sdl_text_dim($fnt, $s, 1)`, `:number sdl_text_dim($fnt, $s, 0)`
    },

    ;; sdl.sound(path): a sound (wav, ogg, ...), or nil
    sound = func (path) {
        `:value sdl_sound($path)`
    },

    ;; sdl.play(snd [,vol]): plays a sound once, with a volume from 0 to
    ;; 1 (default 1); the channel, or -1
    play = func (snd, vol) {
        `:number sdl_play($snd, a_isnum($vol) ? a_dbl($vol) : 1.0)`
    },

    ;; sdl.music(path [,loops [,from, to]]): plays a music `loops` times
    ;; (default -1, forever), in place of the current one; the same
    ;; music goes on; with `to` (seconds), it loops forever: when it
    ;; passes `to` it goes back to `from`, checked once per frame;
    ;; whether the file was loaded
    music = func (path, loops, from, to) {
        `:boolean sdl_music($path, sdl_int($loops,-1), a_isnum($from) ? a_dbl($from) : 0.0, a_isnum($to) ? a_dbl($to) : 0.0)`
    },

    ;; sdl.music_pos(): the position of the music, in seconds, or -1
    music_pos = func () {
        `:number sdl_music_pos()`
    },

    ;; sdl.music_stop([fade]): stops the music, fading out in `fade`
    ;; milliseconds (default 0, at once)
    music_stop = func (fade) {
        `sdl_music_stop(sdl_int($fade,0));`
    },

    ;; sdl.volume(sounds, music): the volumes, from 0 to 1
    volume = func (snd, mus) {
        `sdl_volume(a_isnum($snd) ? a_dbl($snd) : 1.0, a_isnum($mus) ? a_dbl($mus) : 1.0);`
    },

    ;; sdl.display(fullscreen, w, h, grab, cursor): the window in
    ;; fullscreen, or with the size w x h (if greater than 0), the mouse
    ;; grabbed in it, and the cursor shown; the window keeps its size
    ;; in the test mode
    display = func (full, w, h, grab, cursor) {
        `sdl_display(a_truthy($full), sdl_int($w,0), sdl_int($h,0), a_truthy($grab), a_truthy($cursor));`
    },

    ;; sdl.key(name): whether a key is pressed, by the name of the key
    ;; ('A', 'Left Shift') or of its scancode
    key = func (name) {
        `:boolean sdl_key($name)`
    },

    ;; sdl.clock(f): the clock of Atmos goes `f` times as fast as the
    ;; frames (1 by default; 0 stops it), carrying the remainder; the
    ;; time of `:frame` is not affected
    clock = func (f) {
        `SDL_CLOCK = a_isnum($f) ? a_dbl($f) : 1.0;`
    },

    ;; sdl.frame(): the number of the current frame, from 1
    frame = func () {
        `:number SDL_FRAME`
    },

    ;; sdl.testing(): whether in the test mode (SDL_ATM_FRAMES)
    testing = func () {
        `:boolean SDL_TESTING`
    },

    ;; sdl.mouse(): the last position of the mouse
    mouse = func () {
        return `:number SDL_MX`, `:number SDL_MY`
    },

]
