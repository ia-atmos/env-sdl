;; The "Rocks!" game: a spaceship shooter for 2 simultaneous players.
;;
;; Ported from https://github.com/atmos-lang/sdl-rocks (v0.5).
;;
;;      cd exs/rocks
;;      ../../atmos-sdl main.atm [seed]
;;
;; The test of the repository (`tst/run.sh rocks`) runs it with no screen:
;; env: SDL_ATM_FRAMES=320:16
;; env: SDL_ATM_KEYS="5:dn:Return,20:dn:Left Shift,21:up:Left Shift,40:dn:D,90:up:D"
;; env: SDL_ATM_SHOT=100:../../tst/out/rocks-100.png,310:../../tst/out/rocks-310.png
;; args: 1

;; SKIP TO "START HERE"

val W, H = 640, 480
sdl.window [
    title  = "The Battle of Ships",
    width  = W,
    height = H,
]

;; percentages of the window as a position
func PP (x, y) {
    [ x = (W*x)//100, y = (H*y)//100 ]
}

;; the rectangles overlap
func rect_vs_rect (r1, r2) {
    (r1.x < r2.x+r2.w) && (r2.x < r1.x+r1.w) &&
    (r1.y < r2.y+r2.h) && (r2.y < r1.y+r1.h)
}

pin FNT = sdl.font("tiny.ttf", H//15) --> assert

pin SND = [
    explosion = sdl.sound("snds/explosion.wav") --> assert,
    meteor    = sdl.sound("snds/meteor.wav")    --> assert,
    shot      = sdl.sound("snds/shot.wav")      --> assert,
    start     = sdl.sound("snds/start.wav")     --> assert,
]

;; a white text centered at a position
func write (s, pt) {
    val _, h = sdl.text_size(FNT, s)
    sdl.text(FNT, s, pt.x, pt.y - (h//2), 0xFFFFFFFF, :center)
}

val SEED = ...
math.randomseed(tonumber(SEED) || os.time())

include "ts.atm"        ;; task prototypes for Ship, Shot, Meteor
include "battle.atm"    ;; actual battle gameplay

;; START HERE

spawn {    ;; BACKGROUND
    ;;;
    ;; This task is the first to spawn, which makes the background image to
    ;; always be rendered first.
    ;;;
    pin tex = sdl.image("imgs/bg.png") --> assert
    val w, h = sdl.size(tex)
    loop on :draw {
        sdl.scale(tex, 0,0,w,h, 0,0,W,H)
    }
}

val points = [ L=0, R=0 ]

spawn {    ;; POINTS
    ;;;
    ;; Spawns the players points and place them at the bottom of the screen, in
    ;; opposite sides.
    ;; Points are incremented when the ship of the opponent is destroyed.
    ;; Since points must outlive each individual battle, we spawn them here,
    ;; outside the main game loop.
    ;;;
    val l = PP(10, 90)
    val r = PP(90, 90)
    loop on :draw {
        write(tostring(points.L), l)
        write(tostring(points.R), r)
    }
}

;; MAIN-LOOP
;;;
;; Starts the main game loop:
;;  - Shows the "press to start" message.
;;  - Runs the next battle with the actual gameplay.
;;  - Restarts whenever one of the ships is destroyed.
;;;
loop {
    ;; ENTER-TO-START
    watching :key.dn [key='Return'] {
        ;;;
        ;; Spawns the blinking message, and awaits a :Return press.
        ;;;
        loop {
            ;; 500ms on
            watching 500ms {
                val pt = PP(50, 50)
                loop on :draw {
                    write("= PRESS ENTER TO START =", pt)
                }
            }
            ;; 500ms off
            await 500ms
        }
    }

    ;; Plays the restart sound.
    sdl.play(SND.start)

    ;; spawns the actual battle
    pin battle = spawn Battle()

    ;; Pause with 'P':
    ;;  * awaits 'P' to mute the battle
    ;;  * shows a "paused" image
    ;;  * awaits 'P' to unmute the battle
    spawn {
        loop {
            await :key.dn [key='P']
            mute battle(true)
            spawn {
                pin tex = sdl.image("imgs/pause.png") --> assert
                val w, h = sdl.size(tex)
                val pt = PP(50, 50)
                loop on :draw {
                    sdl.draw(tex, pt.x - (w/2), pt.y - (h/2))
                }
            }
            await :key.dn [key='P']
            mute battle(false)
        }
    }

    ;; Battle terminates:
    ;;  * awaits battle to return winner
    ;;  * increments winner points
    ;;  * awaits 1s before next battle
    val winner = await battle
    set points@winner += 1
    await 1s

    ;;;
    ;; Restarts the main loop.
    ;; Due to lexical memory management, only the points are preserved
    ;; between loop iterations.
    ;; All other tasks are guaranteed to abort and be reclaimed after this
    ;; point.
    ;;;
}
