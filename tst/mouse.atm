;; The scripted mouse: motions and buttons (by name or number: a button
;; with no name stays its number), and the last position.
;; env: SDL_ATM_FRAMES=6:16
;; env: SDL_ATM_MOUSE=2:mv:10:20,3:dn:11:21:1,3:up:11:21:1,4:dn:5:6:right,5:up:7:8,6:dn:7:8:4

sdl.window [title="mouse", width=20, height=20]

print(:at, sdl.mouse())
spawn {
    loop e on :mouse.motion {
        print(:motion, e.x, e.y, e.button)
    }
}
spawn {
    loop e on :mouse.button.dn {
        print(:dn, e.x, e.y, e.button)
    }
}
spawn {
    loop e on :mouse.button.up {
        print(:up, e.x, e.y, e.button)
        print(:at, sdl.mouse())
    }
}
await :mouse.button.dn [button=:right]
print(:right)
await false
