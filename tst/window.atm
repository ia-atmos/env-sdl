;; A window, and filled rectangles with a color each.
;; env: SDL_ATM_FRAMES=3:16 SDL_ATM_SHOT=2:out/window-2.png

sdl.window [title="window", width=40, height=30]

loop on :draw {
    sdl.fill(0xFF0000FF, 0, 0, 10, 10)
    sdl.fill(0x00FF00FF, 30, 20, 10, 10)
    sdl.fill(0x0000FFFF, 15, 10, 10, 10)
}
