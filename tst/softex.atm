;; sdl.draw_ex in the software path: a tint, an alpha, a scale, and the
;; blend mode add (the rotation and the flips are ignored there).
;; env: SDL_ATM_FRAMES=2:16 SDL_ATM_SHOT=2:out/softex-2.png

sdl.window [title="softex", width=24, height=8, software=true]

pin ell = sdl.image("res/ell.png")

loop on :draw {
    sdl.fill(0x404040FF, 0, 0, 24, 8)
    sdl.draw_ex(ell, 0,0,4,4, 0,0,4,4, 0, nil, 0x0000FFFF)
    sdl.draw_ex(ell, 0,0,4,4, 5,0,4,4, 0, nil, 0xFFFFFF80)
    sdl.draw_ex(ell, 0,0,4,4, 10,0,4,4, 0, nil, nil, :add)
    sdl.draw_ex(ell, 0,0,4,4, 15,0,8,8, 90, :h)
    sdl.draw(ell, 0, 4)
}
