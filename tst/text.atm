;; A text with a color, aligned left, centered, and right; its size.
;; env: SDL_ATM_FRAMES=2:16 SDL_ATM_SHOT=2:out/text-2.png

sdl.window [title="text", width=80, height=40]

pin fnt = sdl.font("res/tiny.ttf", 10)
print(type(fnt))
print(sdl.font("res/none.ttf", 10))
print(sdl.text_size(fnt, "Atmos"))
print(sdl.text_size(fnt, ""))
print(sdl.text_size(nil, "Atmos"))

loop on :draw {
    sdl.line(0x404040FF, 40, 0, 40, 40)
    sdl.text(fnt, "Atmos", 40, 0, 0xFFFF00FF)
    sdl.text(fnt, "Atmos", 40, 13, 0x00FFFFFF, :center)
    sdl.text(fnt, "Atmos", 40, 26, 0xFF00FFFF, :right)
}
