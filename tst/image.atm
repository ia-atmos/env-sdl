;; An image, its size, whole and cropped, and scaled into a rectangle.
;; env: SDL_ATM_FRAMES=2:16 SDL_ATM_SHOT=2:out/image-2.png

sdl.window [title="image", width=32, height=16]

pin img = sdl.image("res/quad.png")
print(type(img), sdl.size(img))
print(sdl.image("res/none.png"))

loop on :draw {
    sdl.color(0x404040)
    sdl.fill [x=0, y=0, w=32, h=16]
    sdl.copy(img, nil, [x=0, y=0, w=8, h=4])
    sdl.copy(img, [x=4, y=0, w=4, h=2], [x=16, y=0, w=4, h=2])
    sdl.copy(img, [x=0, y=2, w=8, h=2], [x=0, y=8, w=32, h=8])
}
