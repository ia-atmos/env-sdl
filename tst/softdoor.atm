;; The software path with a logical size: the door gives the pixels of
;; an image as the environment blits them (ARGB8888, unless raw), and the
;; logical size is set on the renderer, so that SDL scales the picture and
;; a real mouse as with the renderer path (one scale, letterboxed). A
;; pushed event is not scaled by SDL, so the trace shows the renderer.
;; env: SDL_ATM_FRAMES=3:16

sdl.window [title="softdoor", width=16, height=8, logical=[8,4], software=true]

pin img = sdl.image("res/quad.png")
pin raw = sdl.image("res/quad.png", true)
print(:argb, `:boolean sdl_sfc($img)->format->format == SDL_PIXELFORMAT_ARGB8888`)
print(:raw, `:boolean sdl_sfc($raw)->format->format == SDL_PIXELFORMAT_ARGB8888`)

print(:logical, `:number ({ int w, h; SDL_RenderGetLogicalSize(sdl_ren(), &w, &h); w; })`, `:number ({ int w, h; SDL_RenderGetLogicalSize(sdl_ren(), &w, &h); h; })`)
