;; The factor of the clock: 1/7 as fast, then stopped, then as fast,
;; with the remainder carried; `:frame` keeps the time of the frames.
;; A factor set during `:frame` applies to the time of the same frame.
;; With ATMOS_TIME=ms the clock goes in whole milliseconds, carrying the
;; rest, so this trace is of the default unit.
;; env: SDL_ATM_FRAMES=9:15

sdl.window [title="clock", width=20, height=20]

spawn {
    loop us on :clock {
        print(:clock, sdl.frame(), us * (1000000 // 1s))
    }
}
spawn {
    loop e on :frame {
        print(:frame, e.n, e.us)
        match e.n {
            2 => sdl.clock(1/7)
            5 => sdl.clock(0)
            7 => sdl.clock()
        }
    }
}
print(:testing, sdl.testing())
await false
